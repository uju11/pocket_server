{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/download/server",
      "destination": "https://github.com/uju11/pocket_server/releases/latest/download/pocketnode-server.apk",
      "permanent": false
    },
    {
      "source": "/download/client",
      "destination": "https://github.com/uju11/pocket_server/releases/latest/download/pocketnode-client.apk",
      "permanent": false
    },
    {
      "source": "/releases",
      "destination": "https://github.com/uju11/pocket_server/releases",
      "permanent": false
    },
    {
      "source": "/github",
      "destination": "https://github.com/uju11/pocket_server",
      "permanent": false
    }
  ]
}
